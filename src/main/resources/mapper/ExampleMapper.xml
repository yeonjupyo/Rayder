<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.likelion.backend.example.mapper.ExampleMapper">

	<resultMap id="exampleResultMap" type="com.likelion.backend.example.domain.Example">
		<id property="id" column="id"/>
		<result property="name" column="name"/>
		<result property="createdAt" column="created_at"/>
	</resultMap>

	<select id="findById" resultMap="exampleResultMap">
		SELECT id, name, created_at
		FROM example
		WHERE id = #{id}
	</select>

	<select id="findAll" resultMap="exampleResultMap">
		SELECT id, name, created_at
		FROM example
		ORDER BY id DESC
	</select>

	<insert id="insert" parameterType="com.likelion.backend.example.domain.Example" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO example (name, created_at)
		VALUES (#{name}, NOW())
	</insert>

	<update id="update" parameterType="com.likelion.backend.example.domain.Example">
		UPDATE example
		SET name = #{name}
		WHERE id = #{id}
	</update>

	<delete id="deleteById">
		DELETE FROM example
		WHERE id = #{id}
	</delete>

</mapper>
