<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.uvmate.mapper.UserMapper">
    <select id="getTestUser" resultType="com.example.uvmate.dto.UserDto">
        SELECT user_id AS userId, email, nickname, region
        FROM USER
        WHERE user_id = 1
    </select>
</mapper>